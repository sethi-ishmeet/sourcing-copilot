# Which model drives the copilot: "fake" (no API key needed, deterministic) or "gemini".
MODEL=fake
GEMINI_MODEL=gemini-3.8-flash
GOOGLE_API_KEY=

# API keys for the two roles. Change these outside local development.
VIEWER_API_KEY=viewer-dev-key
RECRUITER_API_KEY=recruiter-dev-key

# Where screenings, steps and the approval checkpoint are stored.
DB_PATH=data/sourcing_copilot.sqlite

# Failure switches used by tests and demos.
PRETEND_LINKEDIN_FAIL_FIRST_SEND=false
MAX_TOOL_CALLS=6
LOG_LEVEL=INFO
